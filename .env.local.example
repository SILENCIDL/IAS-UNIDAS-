# IAS-UNIDAS — Exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com suas chaves
# As chaves também podem ser inseridas diretamente na interface em /configuracoes

# As chaves de API são gerenciadas pelo usuário na interface
# e armazenadas no localStorage do navegador.
# Este arquivo é apenas para referência de quais serviços são suportados.

# Claude / Anthropic
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini / Google AI
# Obtenha em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Kimi / Moonshot AI
# Obtenha em: https://platform.moonshot.cn/
KIMI_API_KEY=
